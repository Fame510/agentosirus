{
  "name": "agency-agents-explorer",
  "version": "1.0.0",
  "description": "An interactive directory, team builder, and chat interface for The Agency's 144 AI specialists.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "latest",
    "express": "^4.19.2",
    "lucide-react": "^0.435.0",
    "motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
