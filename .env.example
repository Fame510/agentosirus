# .env.example
# Server-side Gemini API Key
GEMINI_API_KEY=

# SiliconFlow API Key (Primary LLM Provider)
SILICONFLOW_API_KEY=
# Optional SiliconFlow model (defaults to Qwen/Qwen2.5-72B-Instruct)
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenRouter API Key (Secondary LLM Provider - Defaulting to Free Intelligent Models)
OPENROUTER_API_KEY=
# Optional OpenRouter model (defaults to deepseek/deepseek-chat:free)
OPENROUTER_MODEL=deepseek/deepseek-chat:free
